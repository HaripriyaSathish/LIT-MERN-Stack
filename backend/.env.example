# ---------- Server ----------
PORT=5000
# Public URL of this backend (used for images stored in /uploads)
BASE_URL=http://localhost:5000
# Frontend URL(s) allowed by CORS (comma separated)
CLIENT_URL=http://localhost:5173

# ---------- Database ----------
# Local: MySQL (MySQL Workbench). Leave DATABASE_URL empty / commented.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=lit_website_db

# Production (Render): Neon PostgreSQL. When DATABASE_URL is set, the DB_* values above are ignored
# and the database type is taken from the URL (postgresql:// = PostgreSQL, mysql:// = MySQL).
# Never commit the real URL - put it only in Render -> Environment.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
# Hosted MySQL instead (Aiven...): DATABASE_URL=mysql://user:pass@host:port/db  and  DB_SSL=true

# ---------- Admin login (created by: npm run seed) ----------
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
# Receives "Forgot password" links and security emails (can also be set in Admin -> My account)
ADMIN_EMAIL=

# ---------- Emails (Forgot password + notifications) ----------
# Gmail: SMTP_USER = the Gmail address, SMTP_PASS = an App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords). Not the normal Gmail password.
# Empty = emails are printed in the backend terminal instead of being sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=London Indian Tamils (LIT)

# ---------- Google Analytics (optional) ----------
# The live site uses G-CJ4EXSJEQD. Leave empty in development so local visits are not counted.
# It can also be changed later in Admin -> Site Settings.
GOOGLE_ANALYTICS_ID=

# ---------- Cloudinary (optional) ----------
# Empty = images uploaded from the admin are saved in backend/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
